; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jalura Framework"
config/description="Modulares Godot-4-Framework für Diorama-Adventures."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InventoryManager="*res://scripts/core/inventory_manager.gd"
QuestManager="*res://scripts/core/quest_manager.gd"
SettingsManager="*res://scripts/core/settings_manager.gd"
RoomManager="*res://scripts/core/room_manager.gd"
SaveManager="*res://scripts/core/save_manager.gd"
GameFlags="*res://scripts/core/game_flags.gd"
SceneTransition="*res://scripts/core/scene_transition.gd"
CameraManager="*res://scripts/core/camera_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/jalura_toolkit/plugin.cfg", "res://addons/collision_maker/plugin.cfg")

[gui]

theme/custom="res://assets/ui/jalura_theme.tres"

